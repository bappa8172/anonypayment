# ==============================================================================
# AnonyGateway — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure all variables for your production environment.
# NEVER commit your actual .env file or private keys to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NETWORK_MODE=mainnet

# Public URLs
FRONTEND_URL=https://yourdomain.com
PUBLIC_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# The gateway operates in dual-mode:
# - Leave DATABASE_URL empty to use self-contained SQLite (persisted at data/gateway.db)
# - Or set DATABASE_URL to use PostgreSQL for high-scale enterprise clusters
# DATABASE_URL=postgres://gateway:STRONG_DB_PASSWORD@localhost:5432/gateway
# USE_POSTGRES=false
# SQLITE_DB_PATH=data/gateway.db

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHIC SECRETS (Required >= 32 characters in production)
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace_with_64_hex_chars_or_32_char_random_key_here
SESSION_SECRET=replace_with_64_hex_chars_or_32_char_random_secret_here
WEBHOOK_SECRET=replace_with_64_hex_chars_or_32_char_random_secret_here

# Super Admin Initial Account
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_a_very_strong_admin_password_min_8_chars

# ------------------------------------------------------------------------------
# 4. NETWORK & CORS POLICIES
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (no wildcards in production)
CORS_ORIGIN=https://yourdomain.com

# Comma-separated list of merchant webhook domains allowed to receive notifications
WEBHOOK_ALLOWED_HOSTS=yourdomain.com,merchant.example.com

# ------------------------------------------------------------------------------
# 5. EVM / BSC BLOCKCHAIN ENGINE (BEP-20 USDT & BNB)
# ------------------------------------------------------------------------------
# BIP-39 mnemonic seed phrase for deriving isolated customer invoice deposit addresses
EVM_MNEMONIC="replace with your secure 12 or 24 word mnemonic seed phrase"

# Hot Signer Private Key for Central Treasury (used for auto-sweeps and manual payouts)
TREASURY_PRIVATE_KEY=0x_replace_with_64_hex_treasury_hot_signer_private_key

# BSC Node RPC endpoint (Mainnet)
EVM_RPC_URL=https://bsc-dataseed.binance.org
EVM_CHAIN_ID=56
EVM_CONFIRMATIONS=12

# Official BEP-20 USDT Contract on BSC Mainnet
USDT_BSC_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_BSC_DECIMALS=18

# ------------------------------------------------------------------------------
# 6. TRON BLOCKCHAIN ENGINE (TRC-20 USDT)
# ------------------------------------------------------------------------------
# TRON BIP-44 Derivation Mnemonic or Master Root
TRON_MNEMONIC="replace with your secure 12 or 24 word mnemonic seed phrase"
TRON_API_URL=https://api.trongrid.io
TRON_CONFIRMATIONS=19
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# ------------------------------------------------------------------------------
# 7. BITCOIN BLOCKCHAIN ENGINE (BTC Native SegWit)
# ------------------------------------------------------------------------------
# BIP-84 Native SegWit Mnemonic (bc1q...)
BTC_MNEMONIC="replace with your secure 12 or 24 word mnemonic seed phrase"
BTC_MEMPOOL_API=https://mempool.space/api
BTC_CONFIRMATIONS=1

# ------------------------------------------------------------------------------
# 8. SMTP EMAIL DISPATCH SERVICE
# ------------------------------------------------------------------------------
SMTP_ENABLED=true
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME="AnonyGateway Payments"
