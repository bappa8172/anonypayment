NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=replace_with_a_strong_database_password
DATABASE_URL=postgres://gateway:replace_with_a_strong_database_password@postgres:5432/gateway

# Watch-only extended public key. Never place a seed phrase or private key here.
EVM_XPUB=xpub_replace_me
EVM_RPC_URL=https://your-authenticated-bsc-rpc.example
EVM_CHAIN_ID=56
USDT_BSC_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_BSC_DECIMALS=18
EVM_CONFIRMATIONS=15

# Generate unique values with a secret manager; do not commit a real .env file.
ADMIN_API_KEY=replace_with_at_least_32_random_characters
WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# Comma-separated merchant webhook domains; required to enable webhooks.
WEBHOOK_ALLOWED_HOSTS=merchant.example
