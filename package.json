{
  "name": "anonygateway",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"node src/index.js\" \"npm --prefix client run dev\"",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"node src/index.js\" \"npm --prefix client run dev\"",
    "server": "node src/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node --test"
  },
  "dependencies": {
    "bech32": "^2.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
